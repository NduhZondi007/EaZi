  "payment_flow": {
    "yoco_card": {
      "steps": [
        "1. Client confirms booking and selects 'Pay with Card'",
        "2. App calls Edge Function create-payment with {amount, bookingId, type: 'booking'}",
        "3. Edge Function creates Yoco checkout (POST https://payments.yoco.com/api/checkouts)",
        "4. Edge Function returns {checkoutId, redirectUrl}",
        "5. App opens redirectUrl in WebView (full screen modal)",
        "6. User completes payment on Yoco hosted checkout",
        "7. Yoco redirects to successUrl (eazi://payment-success)",
        "8. App detects deep link, closes WebView, shows Processing spinner",
        "9. SIMULTANEOUSLY: Yoco POST webhook to Edge Function yoco-webhook",
        "10. Edge Function verifies signature, updates transaction/booking/wallet/notifications",
        "11. Client app receives realtime update -> shows Booking Confirmed screen"
      ],
      "yoco_amount_note": "Yoco expects amount in CENTS (e.g., R350.00 = 35000)",
      "minimum_amount": "R2.00 (Yoco minimum)",
      "test_card": "Use test card numbers from Yoco dashboard with sk_test_ key"
    },
    "wallet": {
      "steps": [
        "1. Check wallet balance >= amount",
        "2. Call Edge Function with {type: 'wallet', amount, bookingId}",
        "3. Edge Function deducts balance, creates transaction, updates booking",
        "4. Return success immediately"
      ]
    }
  },

  "realtime_subscriptions": {
    "booking_status": {
      "table": "bookings",
      "event": "UPDATE",
      "filter": "id=eq.{bookingId}",
      "usage": "BookingDetailScreen auto-updates when provider accepts/arrives/completes"
    },
    "chat_messages": {
      "table": "messages",
      "event": "INSERT",
      "filter": "chat_room_id=eq.{roomId}",
      "usage": "ChatRoomScreen receives messages instantly without polling"
    },
    "user_notifications": {
      "table": "notifications",
      "event": "INSERT",
      "filter": "user_id=eq.{userId}",
      "usage": "Bell icon badge count, in-app toast on foreground notification"
    }
  },

