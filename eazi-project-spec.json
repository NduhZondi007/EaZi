{
  "$schema": "eazi-project-spec",
  "version": "1.0.0",
  "project": {
    "name": "EaZi",
    "description": "On-demand digital marketplace connecting verified Service Providers with Clients seeking reliable local services in South Africa",
    "type": "mobile-app",
    "platforms": ["ios", "android"],
    "currency": "ZAR",
    "region": "South Africa"
  },

  "stack": {
    "framework": "react-native",
    "runtime": "expo-managed-workflow",
    "expo_sdk": "52+",
    "language": "typescript",
    "strict_mode": true,
    "backend": "supabase",
    "database": "postgresql",
    "auth": "supabase-auth",
    "realtime": "supabase-realtime",
    "storage": "supabase-storage",
    "serverless": "supabase-edge-functions",
    "payment_gateway": "yoco",
    "maps": "google-maps",
    "push_notifications": "expo-notifications",
    "styling": "nativewind-v4",
    "state_management": "zustand",
    "forms": "react-hook-form",
    "validation": "zod",
    "navigation": "react-navigation-v7",
    "icons": "lucide-react-native",
    "dates": "date-fns",
    "images": "expo-image",
    "monitoring": "sentry",
    "lists": "@shopify/flash-list"
  },

  "dependencies": {
    "core": [
      "@supabase/supabase-js",
      "@react-native-async-storage/async-storage",
      "react-native-url-polyfill"
    ],
    "navigation": [
      "@react-navigation/native",
      "@react-navigation/native-stack",
      "@react-navigation/bottom-tabs",
      "react-native-screens",
      "react-native-safe-area-context"
    ],
    "state_forms": [
      "zustand",
      "react-hook-form",
      "@hookform/resolvers",
      "zod"
    ],
    "ui": [
      "nativewind",
      "tailwindcss",
      "react-native-reanimated",
      "expo-image",
      "lucide-react-native",
      "react-native-svg",
      "@shopify/flash-list"
    ],
    "maps_location": [
      "react-native-maps",
      "expo-location"
    ],
    "media": [
      "expo-image-picker",
      "expo-document-picker",
      "expo-file-system"
    ],
    "notifications": [
      "expo-notifications",
      "expo-device",
      "expo-constants"
    ],
    "utilities": [
      "date-fns",
      "@sentry/react-native",
      "@react-native-community/datetimepicker"
    ]
  },

  "environment_variables": {
    "EXPO_PUBLIC_SUPABASE_URL": { "description": "Supabase project URL", "required": true, "example": "https://xxxxx.supabase.co" },
    "EXPO_PUBLIC_SUPABASE_ANON_KEY": { "description": "Supabase anonymous/public key", "required": true },
    "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": { "description": "Google Maps API key (Maps SDK + Places API)", "required": true },
    "EXPO_PUBLIC_YOCO_PUBLIC_KEY": { "description": "Yoco public key (pk_test_ for dev, pk_live_ for prod)", "required": true },
    "EXPO_PUBLIC_SENTRY_DSN": { "description": "Sentry DSN for error tracking", "required": false }
  },

  "edge_function_secrets": {
    "YOCO_SECRET_KEY": { "description": "Yoco secret key for server-side payment creation" },
    "YOCO_WEBHOOK_SECRET": { "description": "Yoco webhook signing secret for signature verification" },
    "EXPO_PUSH_ACCESS_TOKEN": { "description": "Expo push notification access token" },
    "SUPABASE_SERVICE_ROLE_KEY": { "description": "Auto-available in Edge Functions for bypassing RLS" }
  },

  "roles": {
    "client": {
      "description": "End-user who discovers, books, pays for, and reviews services",
      "default_status": "active",
      "capabilities": [
        "browse_services", "search_filter_services", "view_service_details",
        "view_provider_profiles", "create_bookings", "quick_book_5km",
        "pay_for_bookings", "cancel_bookings", "track_booking_status",
        "leave_reviews", "tip_providers", "chat_with_providers",
        "manage_wallet", "top_up_wallet", "manage_saved_cards",
        "view_transactions", "manage_profile", "manage_notifications",
        "submit_support_queries", "report_emergencies"
      ]
    },
    "provider": {
      "description": "Verified service provider who lists services, manages bookings, and earns income",
      "default_status": "pending_approval",
      "requires_verification": true,
      "max_services": 5,
      "capabilities": [
        "create_services", "edit_services", "delete_services",
        "manage_gallery", "set_pricing_hours", "toggle_availability",
        "view_incoming_bookings", "accept_bookings", "decline_bookings",
        "mark_arrived", "mark_in_progress", "complete_bookings",
        "view_earnings", "withdraw_earnings", "chat_with_clients",
        "manage_profile", "upload_documents", "manage_notifications",
        "submit_support_queries"
      ],
      "required_documents": [
        { "type": "id", "label": "Government-issued ID", "required": true },
        { "type": "address_proof", "label": "Proof of Residence", "required": true },
        { "type": "clearance", "label": "Police Clearance Certificate", "required": true },
        { "type": "license", "label": "Driver's License", "required": false, "condition": "service_type === 'Transport'" }
      ]
    },
    "admin": {
      "description": "Platform administrator who manages users, verifies providers, and views analytics",
      "default_status": "active",
      "capabilities": [
        "view_all_users", "filter_users", "activate_block_users", "delete_users",
        "view_verification_queue", "review_documents", "approve_providers", "reject_providers",
        "view_revenue_metrics", "view_engagement_stats", "view_service_performance",
        "manage_promotions", "handle_support_queries", "assign_queries",
        "view_emergencies", "assign_responders", "resolve_emergencies"
      ]
    }
  },

  "service_categories": [
    "Cleaning", "Plumbing", "Electrical", "Beauty",
    "Transport", "Tutoring", "Photography", "Personal Training",
    "Gardening", "Handyman", "Moving", "Catering", "Other"
  ],

  "design_patterns": {
    "repository": {
      "purpose": "Abstract all Supabase data access behind interfaces",
      "interface": "IRepository<T> with findById, findMany, create, update, delete",
      "implementations": [
        "UserRepository", "ServiceRepository", "BookingRepository",
        "WalletRepository", "TransactionRepository", "ChatRepository",
        "NotificationRepository", "ReviewRepository", "QueryRepository", "AdminRepository"
      ],
      "location": "src/repositories/"
    },
    "strategy": {
      "purpose": "Interchangeable payment processing methods",
      "interface": "IPaymentStrategy with processPayment, refund, validatePayment",
      "implementations": ["YocoCardStrategy", "WalletStrategy", "EaziCashStrategy"],
      "location": "src/services/payment/"
    },
    "state_machine": {
      "purpose": "Enforce valid booking state transitions",
      "class": "BookingStateMachine",
      "location": "src/services/booking-state-machine.ts",
      "transitions": {
        "pending": ["confirmed", "cancelled"],
        "confirmed": ["accepted", "declined", "cancelled"],
        "accepted": ["arrived", "cancelled"],
        "arrived": ["in_progress", "cancelled"],
        "in_progress": ["completed"],
        "completed": ["reviewed"]
      }
    },
    "observer": {
      "purpose": "Supabase Realtime subscriptions managed centrally",
      "class": "RealtimeManager",
      "location": "src/services/realtime.manager.ts",
      "subscriptions": ["booking_changes", "chat_messages", "notifications"]
    },
    "factory": {
      "purpose": "Role-specific user creation logic",
      "implementation": "PostgreSQL trigger handle_new_user() on auth.users INSERT",
      "creates": ["users row", "wallets row", "admins row (if admin)"]
    },
    "facade": {
      "purpose": "Unified service discovery combining search, filter, geo queries",
      "class": "ServiceDiscoveryFacade",
      "location": "src/services/service-discovery.facade.ts",
      "methods": ["search", "getFeatured", "getByCategory", "getNearby", "getProviderProfile"]
    }
  },

  "database": {
    "extensions": ["uuid-ossp", "postgis"],
    "tables": {
      "users": {
        "description": "All user accounts (clients, providers, admins)",
        "primary_key": "id UUID REFERENCES auth.users(id)",
        "columns": {
          "id": "UUID PK",
          "name": "TEXT NOT NULL",
          "email": "TEXT UNIQUE NOT NULL",
          "role": "user_role NOT NULL DEFAULT 'client'",
          "status": "user_status NOT NULL DEFAULT 'active'",
          "profile_image_url": "TEXT",
          "phone": "TEXT UNIQUE",
          "is_verified": "BOOLEAN DEFAULT FALSE",
          "bio": "TEXT",
          "gender": "gender_type",
          "date_of_birth": "DATE",
          "address": "TEXT",
          "home_address": "TEXT",
          "office_address": "TEXT",
          "latitude": "DOUBLE PRECISION",
          "longitude": "DOUBLE PRECISION",
          "location": "GEOGRAPHY(Point, 4326)",
          "push_token": "TEXT",
          "created_at": "TIMESTAMPTZ DEFAULT NOW()",
          "updated_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "indexes": ["role", "status", "location (GIST)"],
        "rls": {
          "select": ["own profile", "admin reads all", "public reads active providers"],
          "update": ["own profile", "admin updates any"],
          "insert": "auth trigger only"
        }
      },
      "services": {
        "description": "Service listings created by providers",
        "columns": {
          "id": "UUID PK DEFAULT uuid_generate_v4()",
          "provider_id": "UUID FK -> users(id) CASCADE",
          "business_name": "TEXT NOT NULL",
          "title": "TEXT NOT NULL",
          "description": "TEXT NOT NULL",
          "service_type": "TEXT NOT NULL",
          "operating_hours": "JSONB DEFAULT '{}'",
          "is_available": "BOOLEAN DEFAULT TRUE",
          "base_price": "NUMERIC(10,2) NOT NULL CHECK >= 0",
          "gallery": "TEXT[] DEFAULT '{}'",
          "social_links": "JSONB DEFAULT '{}'",
          "avg_rating": "NUMERIC(3,2) DEFAULT 0",
          "review_count": "INTEGER DEFAULT 0",
          "is_featured": "BOOLEAN DEFAULT FALSE",
          "is_verified": "BOOLEAN DEFAULT FALSE",
          "created_at": "TIMESTAMPTZ DEFAULT NOW()",
          "updated_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "indexes": ["provider_id", "service_type", "is_available", "is_featured"],
        "rls": {
          "select": "public reads available; provider reads own; admin reads all",
          "insert": "provider inserts own (auth.uid() = provider_id)",
          "update": "provider updates own; admin updates any",
          "delete": "provider deletes own; admin deletes any"
        }
      },
      "bookings": {
        "description": "Booking records between clients and providers",
        "columns": {
          "id": "UUID PK DEFAULT uuid_generate_v4()",
          "client_id": "UUID FK -> users(id)",
          "provider_id": "UUID FK -> users(id)",
          "service_id": "UUID FK -> services(id)",
          "booking_for": "booking_for DEFAULT 'self'",
          "recipient_name": "TEXT",
          "recipient_phone": "TEXT",
          "service_address": "TEXT NOT NULL",
          "date": "DATE NOT NULL",
          "time": "TIME NOT NULL",
          "estimated_duration": "INTEGER",
          "is_quick_booking": "BOOLEAN DEFAULT FALSE",
          "status": "booking_status DEFAULT 'pending'",
          "status_history": "JSONB DEFAULT '[]'",
          "amount": "NUMERIC(10,2) NOT NULL CHECK >= 0",
          "tip_amount": "NUMERIC(10,2) DEFAULT 0",
          "payment_method": "payment_method",
          "is_reviewed": "BOOLEAN DEFAULT FALSE",
          "review_id": "UUID",
          "created_at": "TIMESTAMPTZ DEFAULT NOW()",
          "updated_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "indexes": ["client_id", "provider_id", "service_id", "status", "date"],
        "realtime_enabled": true,
        "rls": {
          "select": "client reads own; provider reads assigned; admin reads all",
          "insert": "client creates (auth.uid() = client_id)",
          "update": "provider updates status; client updates own; admin updates any"
        }
      },
      "wallets": {
        "description": "User wallet balances and earnings",
        "columns": {
          "id": "UUID PK DEFAULT uuid_generate_v4()",
          "user_id": "UUID UNIQUE FK -> users(id) CASCADE",
          "balance": "NUMERIC(10,2) DEFAULT 0 CHECK >= 0",
          "eazi_cash_balance": "NUMERIC(10,2) DEFAULT 0 CHECK >= 0",
          "total_earnings": "NUMERIC(10,2) DEFAULT 0",
          "pending_earnings": "NUMERIC(10,2) DEFAULT 0",
          "failed_attempts": "INTEGER DEFAULT 0",
          "updated_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "rls": {
          "select": "own wallet; admin reads all",
          "update": "Edge Functions only (service_role)"
        }
      },
      "cards": {
        "description": "Saved payment card tokens",
        "columns": {
          "id": "UUID PK", "user_id": "UUID FK", "card_token": "TEXT NOT NULL",
          "last4": "TEXT NOT NULL", "brand": "TEXT NOT NULL",
          "exp_month": "INTEGER", "exp_year": "INTEGER", "is_default": "BOOLEAN DEFAULT FALSE"
        },
        "rls": "user manages own cards only"
      },
      "transactions": {
        "description": "Financial transaction records",
        "columns": {
          "id": "UUID PK", "user_id": "UUID FK", "wallet_id": "UUID FK",
          "type": "transaction_type NOT NULL", "amount": "NUMERIC(10,2) NOT NULL",
          "currency": "TEXT DEFAULT 'ZAR'", "method": "payment_method",
          "status": "transaction_status DEFAULT 'pending'",
          "booking_id": "UUID FK nullable", "service_id": "UUID FK nullable",
          "card_id": "UUID FK nullable", "metadata": "JSONB DEFAULT '{}'",
          "created_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "rls": {
          "select": "own transactions; admin reads all",
          "insert": "Edge Functions only",
          "update": "Edge Functions only"
        }
      },
      "reviews": {
        "description": "Client reviews of completed bookings",
        "columns": {
          "id": "UUID PK", "booking_id": "UUID UNIQUE FK", "service_id": "UUID FK",
          "user_id": "UUID FK", "rating": "INTEGER CHECK 1-5",
          "comment": "TEXT NOT NULL", "tipped": "BOOLEAN DEFAULT FALSE"
        },
        "trigger": "AFTER INSERT -> update_service_rating() recalculates avg_rating and review_count",
        "rls": { "select": "public", "insert": "authenticated user (auth.uid() = user_id)" }
      },
      "chat_rooms": {
        "description": "Chat conversations between two participants",
        "columns": {
          "id": "UUID PK", "participant_a_id": "UUID FK", "participant_b_id": "UUID FK",
          "is_admin_chat": "BOOLEAN DEFAULT FALSE", "booking_id": "UUID FK nullable"
        },
        "rls": "participants read/create own rooms; admin reads all"
      },
      "messages": {
        "description": "Chat messages within rooms",
        "columns": {
          "id": "UUID PK", "chat_room_id": "UUID FK CASCADE",
          "sender_id": "UUID FK", "content": "TEXT NOT NULL",
          "status": "message_status DEFAULT 'sent'"
        },
        "realtime_enabled": true,
        "rls": "chat room participants only (JOIN check on chat_rooms)"
      },
      "notifications": {
        "description": "In-app notifications for all users",
        "columns": {
          "id": "UUID PK", "user_id": "UUID FK", "role": "user_role",
          "title": "TEXT NOT NULL", "message": "TEXT NOT NULL",
          "type": "notification_type NOT NULL", "read": "BOOLEAN DEFAULT FALSE",
          "delivered": "BOOLEAN DEFAULT FALSE", "data": "JSONB DEFAULT '{}'",
          "read_at": "TIMESTAMPTZ"
        },
        "realtime_enabled": true,
        "rls": { "select": "own notifications", "update": "own (mark read)" }
      },
      "provider_documents": {
        "description": "Documents submitted by providers for verification",
        "columns": {
          "id": "UUID PK", "provider_id": "UUID FK CASCADE",
          "document_type": "document_type NOT NULL", "file_url": "TEXT NOT NULL",
          "file_name": "TEXT NOT NULL", "status": "document_status DEFAULT 'pending'",
          "submitted_at": "TIMESTAMPTZ DEFAULT NOW()", "reviewed_at": "TIMESTAMPTZ",
          "reviewed_by_admin_id": "UUID FK nullable", "rejection_reason": "TEXT"
        },
        "rls": { "select": "own docs or admin", "insert": "provider own", "update": "admin only" }
      },
      "queries": {
        "description": "Support tickets from users",
        "columns": {
          "id": "UUID PK", "user_id": "UUID FK", "subject": "TEXT NOT NULL",
          "description": "TEXT NOT NULL", "category": "query_category NOT NULL",
          "priority": "query_priority DEFAULT 'medium'",
          "status": "query_status DEFAULT 'open'", "assigned_to": "UUID FK nullable",
          "resolution": "TEXT", "messages": "JSONB DEFAULT '[]'"
        },
        "rls": { "select": "own or admin", "insert": "authenticated", "update": "own or admin" }
      },
      "trips": {
        "description": "Trip tracking for bookings",
        "columns": {
          "id": "UUID PK", "booking_id": "UUID UNIQUE FK",
          "provider_id": "UUID FK", "client_id": "UUID FK",
          "start_location": "JSONB", "end_location": "JSONB",
          "status": "trip_status DEFAULT 'pending'",
          "estimated_arrival": "TIMESTAMPTZ", "actual_arrival": "TIMESTAMPTZ",
          "estimated_distance": "NUMERIC(10,2)", "actual_distance": "NUMERIC(10,2)"
        },
        "rls": "booking parties and admin"
      },
      "emergencies": {
        "description": "Emergency reports from users",
        "columns": {
          "id": "UUID PK", "user_id": "UUID FK", "severity": "emergency_severity",
          "description": "TEXT NOT NULL", "location": "JSONB", "address": "TEXT",
          "related_booking_id": "UUID FK nullable",
          "status": "emergency_status DEFAULT 'reported'",
          "assigned_responder": "UUID FK nullable"
        },
        "rls": { "select": "own or admin", "insert": "authenticated", "update": "admin" }
      },
      "cancellations": {
        "description": "Cancellation records for bookings",
        "columns": {
          "id": "UUID PK", "booking_id": "UUID FK",
          "client_id": "UUID FK", "provider_id": "UUID FK",
          "cancellation_reason": "TEXT", "cancelled_by": "cancelled_by_type",
          "cancelled_at": "TIMESTAMPTZ DEFAULT NOW()"
        },
        "rls": "booking parties and admin"
      },
      "promotions": {
        "description": "Platform promotions and featured services",
        "rls": { "select": "public reads active", "all": "admin manages" }
      },
      "admins": {
        "description": "Admin role configuration and permissions",
        "rls": "admin reads own"
      },
      "provider_requests": {
        "description": "Provider requests to admin",
        "rls": { "select": "own or admin", "insert": "provider", "update": "admin" }
      },
      "service_gallery": {
        "description": "Service gallery images",
        "rls": { "select": "public", "all": "provider manages own service gallery" }
      }
    },
    "triggers": [
      "on_auth_user_created -> handle_new_user(): Creates users row + wallets row",
      "update_user_location: Auto-generates GEOGRAPHY from lat/lon",
      "update_updated_at: Auto-updates updated_at on all tables",
      "update_service_rating: Recalculates avg_rating and review_count after review INSERT"
    ],
    "functions": [
      "handle_new_user(): Creates user profile + wallet on signup",
      "update_user_location(): Converts lat/lon to PostGIS geography",
      "update_updated_at(): Sets updated_at to NOW() on any update",
      "update_service_rating(): Recalculates service rating after review",
      "get_admin_dashboard_stats(): Returns aggregated admin dashboard metrics",
      "is_admin(): Helper to check if current user has admin role"
    ],
    "realtime_tables": ["bookings", "messages", "notifications"]
  },

  "storage_buckets": {
    "avatars": {
      "public": true,
      "allowed_mime": ["image/jpeg", "image/png", "image/webp"],
      "max_size_mb": 5,
      "path_pattern": "{user_id}/avatar.{ext}",
      "policy": "Anyone reads. Authenticated users upload/update/delete own."
    },
    "service-gallery": {
      "public": true,
      "allowed_mime": ["image/jpeg", "image/png", "image/webp"],
      "max_size_mb": 10,
      "max_files_per_service": 5,
      "path_pattern": "{service_id}/{filename}",
      "policy": "Anyone reads. Providers manage own service images."
    },
    "provider-documents": {
      "public": false,
      "allowed_mime": ["image/jpeg", "image/png", "application/pdf"],
      "max_size_mb": 20,
      "path_pattern": "{user_id}/{document_type}.{ext}",
      "policy": "Provider reads own. Admin reads all. Provider uploads own."
    }
  },

  "edge_functions": {
    "create-payment": {
      "auth": "jwt_required",
      "method": "POST",
      "purpose": "Create Yoco checkout session for booking payment or wallet top-up",
      "input": {
        "amount": "number (in ZAR, e.g. 350.00)",
        "booking_id": "string (optional, required if type=booking)",
        "type": "'booking' | 'topup'",
        "currency": "'ZAR'"
      },
      "output": { "checkout_id": "string", "redirect_url": "string" },
      "logic": [
        "1. Verify authenticated user via JWT",
        "2. If type=booking: verify booking exists, belongs to user, status is pending",
        "3. Create transaction record with status 'pending'",
        "4. POST to https://payments.yoco.com/api/checkouts with amount_in_cents",
        "5. Return checkout URL for WebView redirect"
      ]
    },
    "yoco-webhook": {
      "auth": "verify_jwt_false",
      "method": "POST",
      "purpose": "Handle Yoco payment webhook callbacks",
      "logic": [
        "1. Verify webhook signature using YOCO_WEBHOOK_SECRET",
        "2. Parse event type from payload",
        "3. If payment.succeeded:",
        "   a. Update transaction -> status: completed",
        "   b. If booking: Update booking -> status: confirmed, add status_history entry",
        "   c. If booking: Credit provider pending_earnings in wallets",
        "   d. If topup: Credit user wallet balance",
        "   e. Create notifications for relevant parties",
        "   f. Call send-push-notification",
        "4. If payment.failed:",
        "   a. Update transaction -> status: failed",
        "   b. If booking: Update booking -> status: cancelled",
        "   c. Notify user of failure",
        "5. Return 200 OK"
      ]
    },
    "send-push-notification": {
      "auth": "internal_only",
      "method": "POST",
      "purpose": "Send Expo push notifications via Expo Push API",
      "input": {
        "user_id": "string",
        "title": "string",
        "body": "string",
        "data": "object (optional, for deep linking)"
      },
      "logic": [
        "1. Look up user push_token from users table",
        "2. If no token, skip silently",
        "3. POST to https://exp.host/--/api/v2/push/send",
        "4. Handle response for invalid/expired tokens"
      ]
    }
  },

  "navigation": {
    "auth_stack": {
      "screens": ["WelcomeScreen", "LoginScreen", "SignUpScreen", "ForgotPasswordScreen", "ResetPasswordScreen"],
      "condition": "user is NOT authenticated"
    },
    "client_tabs": {
      "condition": "user.role === 'client'",
      "tabs": {
        "HomeTab": {
          "icon": "Home",
          "stack": ["HomeScreen", "ServiceDetailScreen", "ProviderProfileScreen"]
        },
        "BookingsTab": {
          "icon": "Calendar",
          "stack": ["BookingsListScreen", "BookingDetailScreen"]
        },
        "ChatTab": {
          "icon": "MessageCircle",
          "stack": ["ChatListScreen", "ChatRoomScreen"]
        },
        "WalletTab": {
          "icon": "Wallet",
          "stack": ["WalletScreen", "TransactionHistoryScreen"]
        },
        "ProfileTab": {
          "icon": "User",
          "stack": ["ProfileScreen", "EditProfileScreen", "SettingsScreen", "SupportScreen", "SupportDetailScreen"]
        }
      }
    },
    "provider_tabs": {
      "condition": "user.role === 'provider' AND user.status === 'active'",
      "tabs": {
        "DashboardTab": { "icon": "LayoutDashboard", "stack": ["ProviderDashboardScreen"] },
        "ServicesTab": { "icon": "Briefcase", "stack": ["MyServicesScreen", "CreateServiceScreen", "EditServiceScreen"] },
        "BookingsTab": { "icon": "Calendar", "stack": ["ProviderBookingsScreen", "ProviderBookingDetailScreen"] },
        "ChatTab": { "icon": "MessageCircle", "stack": ["ChatListScreen", "ChatRoomScreen"] },
        "ProfileTab": { "icon": "User", "stack": ["ProfileScreen", "EditProfileScreen"] }
