{
  "permissions": {
    "allow": [
      "Bash(npx expo *)",
      "Bash(npx create-expo-app *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npx expo install *)",
      "Bash(npx supabase *)",
      "Bash(node *)",
      "Bash(npx tsc *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(git *)",
      "Bash(cd *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(jest *)",
      "Bash(npx jest *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'File modified — remember to typecheck after completing this phase'"
          }
        ]
      }
    ]
  }
}