  "build_phases": [
    { "phase": 0, "name": "Project Initialization", "tasks": ["Create Expo project", "Install all dependencies", "Configure TypeScript, NativeWind, .env", "Verify build compiles"] },
    { "phase": 1, "name": "Supabase Backend", "tasks": ["Run complete SQL schema", "Apply RLS policies", "Configure storage buckets", "Configure auth providers", "Deploy Edge Functions", "Initialize Supabase client in app", "Generate TypeScript types"] },
    { "phase": 2, "name": "Authentication", "tasks": ["AuthService", "AuthStore (Zustand)", "WelcomeScreen", "LoginScreen", "SignUpScreen (multi-step)", "ForgotPasswordScreen", "ResetPasswordScreen", "Auth state listener", "AuthGate route protection"] },
    { "phase": 3, "name": "Navigation & Layout", "tasks": ["RootNavigator", "AuthStack", "ClientTabNavigator", "ProviderTabNavigator", "AdminTabNavigator", "Tab bar styling", "ScreenWrapper", "Header", "LoadingScreen", "EmptyState", "ErrorState"] },
    { "phase": 4, "name": "Service Discovery", "tasks": ["ServiceDiscoveryFacade", "ServiceRepository", "ServiceStore", "HomeScreen", "ServiceCard", "ServiceDetailScreen", "ProviderProfileScreen", "Search, filter, sort"] },
    { "phase": 5, "name": "Booking System", "tasks": ["BookingStateMachine", "BookingRepository", "BookingStore", "BookingModal (multi-step)", "BookingDetailScreen", "Status timeline", "Realtime subscription"] },
    { "phase": 6, "name": "Payment Integration", "tasks": ["IPaymentStrategy interface", "YocoCardStrategy", "WalletStrategy", "EaziCashStrategy", "PaymentService", "WebView checkout flow", "Webhook handling", "Wallet top-up"] },
    { "phase": 7, "name": "Provider Dashboard", "tasks": ["ProviderDashboardScreen", "MyServicesScreen", "CreateServiceScreen", "EditServiceScreen", "Provider booking management"] },
    { "phase": 8, "name": "Real-time Chat", "tasks": ["ChatRepository", "RealtimeManager", "ChatListScreen", "ChatRoomScreen", "Message bubbles", "Delivery status", "Pagination"] },
    { "phase": 9, "name": "Notifications", "tasks": ["NotificationService", "NotificationStore", "Push notification setup", "In-app notifications screen", "Deep linking from notifications"] },
    { "phase": 10, "name": "Admin Panel", "tasks": ["AdminDashboardScreen", "UserListScreen", "UserDetailScreen", "VerificationQueueScreen", "VerificationDetailScreen", "QueriesListScreen", "QueryDetailScreen", "AnalyticsScreen"] },
    { "phase": 11, "name": "Reviews, Ratings & Wallet", "tasks": ["Review flow", "Star rating component", "WalletScreen", "TransactionHistoryScreen", "Saved cards", "Withdrawal flow"] },
    { "phase": 12, "name": "Maps & Quick Booking", "tasks": ["LocationService", "PostGIS setup", "Quick booking flow", "Map integration in booking", "Address autocomplete"] },
    { "phase": 13, "name": "Polish & Edge Cases", "tasks": ["Error boundary", "Network handling", "Skeleton loading states", "Empty states for all lists", "Input validation with Zod", "Accessibility", "Performance (FlashList, memo, expo-image)"] },
    { "phase": 14, "name": "Testing", "tasks": ["Jest + Testing Library setup", "Repository tests", "Service tests", "State machine tests (100% coverage)", "Payment strategy tests", "Screen render tests"] },
    { "phase": 15, "name": "Deployment", "tasks": ["app.config.ts", "eas.json", "GitHub Actions CI/CD", "EAS Build preview + production", "App store submission config"] }
  ],

  "rules": {
    "CRITICAL": [
      "NEVER output partial files — every file must be complete and runnable",
      "NEVER use // TODO, // implement later, or placeholder functions",
      "ALWAYS handle errors, loading states, and edge cases",
      "ALWAYS include TypeScript types for everything",
      "ALWAYS use the design patterns specified (Repository, Strategy, State Machine, Observer, Factory, Facade)",
      "Build features incrementally — complete and test each phase before proceeding",
      "After each phase: verify compile with npx expo start, summarize what was built, then proceed"
    ],
    "code_style": [
      "Use ES modules (import/export), never CommonJS (require)",
      "Destructure imports: import { useState } from 'react'",
      "Use path aliases: @/ maps to ./src/",
      "Prefer functional components with hooks",
      "Use React.memo for list item components",
      "Use Zustand selectors, not full store subscriptions",
      "All Supabase calls go through repository classes, never directly in components",
      "All payment logic goes through PaymentService/strategies, never inline",
      "All booking status changes go through BookingStateMachine, never direct updates"
    ],
    "naming": {
      "files": "PascalCase for components/screens, camelCase for services/hooks/stores",
      "components": "PascalCase",
      "hooks": "camelCase prefixed with use",
      "stores": "camelCase suffixed with Store",
      "repositories": "PascalCase suffixed with Repository",
      "services": "PascalCase suffixed with Service/Facade/Strategy",
      "types": "PascalCase, interfaces prefixed with I for service interfaces only"
    }
  }
}
